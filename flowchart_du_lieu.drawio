;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="1140" width="620" height="870" as="geometry"/></mxCell><mxCell id="n62" value="sample_for_experts.py: lấy ngẫu nhiên phân tầng 40 mẫu&lt;br&gt;(fine-tune, QA tự sinh, kho dinh dưỡng, kho tâm lý)&lt;br&gt;→ 8 người chấm độc lập (Likert 1–5 + cột chọn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="1190" width="360" height="90" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n44" target="n62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n64" value="expert_agreement.py: Fleiss' κ, Krippendorff's α, Gwet's AC&lt;br&gt;→ TONG_KET_CHUYEN_GIA.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="1310" width="360" height="60" as="geometry"/></mxCell><mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n62" target="n64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n66" value="3 bộ test 300 câu (crisis, retrieval, safety)&lt;br&gt;chỉ chạy trên hệ thống đã cố định;&lt;br&gt;không dùng để viết prompt, từ khoá, luật" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;size=0.15;" vertex="1" parent="1"><mxGeometry x="830" y="1410" width="360" height="80" as="geometry"/></mxCell><mxCell id="n67" value="make_kaggle_package.py: gói hệ thống + manifest sha256&lt;br&gt;→ Kaggle (T4 ×2): kiểm sha256 file, GGUF, digest model, bge-m3&lt;br&gt;→ dựng PostgreSQL, Redis, Neo4j, Ollama → seed → unit test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="1520" width="360" height="90" as="geometry"/></mxCell><mxCell id="e68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n66" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n69" value="eval_system.py · eval_baselines.py (P và 3 baseline) · eval_grounding.py&lt;br&gt;→ giám khảo gemma3:4b → analyze_final.py (số chính thức)&lt;br&gt;→ chấm tay các ca trượt (chỉ để phân tích lỗi)&lt;br&gt;→ BAO_CAO_DANH_GIA.md · BAO_CAO_KET_QUA_CUOI.docx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="1640" width="360" height="100" as="geometry"/></mxCell><mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n67" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n71" value="Chú thích: tài liệu xám = file dữ liệu; tím = bước dùng LLM; vàng = điều kiện; cam = mồi cho nhóm B; đỏ = tập test an toàn; xanh lá = đầu ra / kết quả; nét đứt = dùng làm đầu vào phụ hoặc kiểm tra." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="0" y="2030" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net"><diagram name="Luồng dữ liệu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Luồng dữ liệu: từ nguồn thô đến model fine-tune, cơ sở dữ liệu RAG và đánh giá" style="text;html=1;whiteSpace=wrap;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="-70" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n3" value="1. Dữ liệu hội thoại → fine-tune LLM #2" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="760" height="2010" as="geometry"/></mxCell><mxCell id="n4" value="Nguồn hội thoại tư vấn tâm lý&lt;br&gt;5.000 mẫu từ internet (dịch EN → VI theo MASTER_PROMPT_DICH)&lt;br&gt;+ 1.000 mẫu do LLM sinh" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;size=0.15;" vertex="1" parent="1"><mxGeometry x="180" y="50" width="340" height="80" as="geometry"/></mxCell><mxCell id="n5" value="Lọc an toàn nhóm A (LLM #1 + keyword):&lt;br&gt;khủng hoảng, dùng thuốc, rối loạn ăn uống rõ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="200" y="170" width="300" height="70" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="Tập test Safety Detector&lt;br&gt;(mẫu khủng hoảng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="165" width="190" height="60" as="geometry"/></mxCell><mxCell id="n8" value="Mồi B3&lt;br&gt;(mẫu dùng thuốc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="245" width="190" height="50" as="geometry"/></mxCell><mxCell id="e9" value="khủng hoảng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="dùng thuốc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="Làm sạch: bỏ dấu vết nhập vai, chuẩn hoá khoảng trắng,&lt;br&gt;lọc gần trùng (cosine ≥ 0,9 trên embedding tin nhắn user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="280" width="340" height="70" as="geometry"/></mxCell><mxCell id="e12" value="còn lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="Fact-check các nhận định thực tế (Perplexity)&lt;br&gt;Sửa câu trả lời đã kiểm chứng: chỉ xoá / thêm câu, ghi log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="380" width="340" height="70" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="Chuyển format chuẩn: system prompt cố định + khối động,&lt;br&gt;lượt cuối là chuỗi JSON (json.dumps)&lt;br&gt;Gán nhãn thought_process (API, few-shot, không mang lịch sử)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="480" width="340" height="90" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="side_talk &lt; 20 từ&lt;br&gt;và không có câu hỏi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="600" width="240" height="100" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="Mồi B1&lt;br&gt;(câu trả lời quá ngắn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="620" width="190" height="60" as="geometry"/></mxCell><mxCell id="e20" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="Chia nhóm A (mẫu cùng cụm nằm cùng phía):&lt;br&gt;20% A-test (khoá, ưu tiên mẫu chuyên gia kiểm chứng)&lt;br&gt;80% còn lại; chia mồi phụ B1, B3 theo 80/20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="730" width="340" height="90" as="geometry"/></mxCell><mxCell id="e22" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n17" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="Sinh nhóm B theo quy tắc (sau khi A-test đã chốt)&lt;br&gt;B1 hỏi thêm state · B2 gợi ý món · B3 dùng thuốc · B4 bẫy hỏi ăn uống&lt;br&gt;mồi A-train → B-train; mồi A-test → B-test; few-shot từ A-train&lt;br&gt;B3 dùng / sửa bản bác sĩ duyệt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="850" width="380" height="110" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="n19" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n8" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="QA dữ liệu train:&lt;br&gt;nhóm B: rà soát chéo 2 họ LLM (cả hai gắn cờ thì loại) · Perplexity&lt;br&gt;check_traindata.py – kiểm tra luật tự động&lt;br&gt;fix_traindata.py – sửa có ghi log (3.546 thay đổi: reasoning,&lt;br&gt;câu hỏi state, khuyên đi khám, xưng hô, câu hứa hẹn…)&lt;br&gt;finalize_step2.py – bỏ 68 mẫu B2-train trùng B2-test;&lt;br&gt;mẫu khủng hoảng / dùng thuốc → safetyguard.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="985" width="400" height="150" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n23" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="traindata_logs/&lt;br&gt;check_traindata · fix_traindata · finalize_step2&lt;br&gt;change_log.jsonl · removed_samples.jsonl" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;size=0.15;" vertex="1" parent="1"><mxGeometry x="550" y="1005" width="200" height="100" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="Tách validation 10% mỗi nhóm&lt;br&gt;Trộn A-train + B-train (không oversample), seed cố định&lt;br&gt;train 6.847 (A 3.447 · B1 859 · B2 813 · B3 864 · B4 864)&lt;br&gt;validation 750 · test 1.916 (traindata/group_*.jsonl, test_*.jsonl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="1140" width="340" height="100" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n27" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="Fine-tune Qwen2.5-7B-Instruct + LoRA&lt;br&gt;(r 16, alpha 32, mọi lớp linear; Kaggle TPU v5e-8, bf16)&lt;br&gt;loss chỉ lượt assistant cuối; early stopping&lt;br&gt;val loss tốt nhất 0,6687 → best_adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="1270" width="340" height="100" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="Gộp LoRA vào model gốc → lượng tử GGUF Q4_K_M&lt;br&gt;(export_gguf_kaggle) → Ollama: qwen-huhu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="1400" width="340" height="70" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n33" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="Đánh giá model trên tập test (huhuevalu.ipynb)&lt;br&gt;perplexity 11,23 → 2,41 · ROUGE-L 0,155 → 0,319&lt;br&gt;BERTScore 0,872 → 0,908 · luật JSON 0% → 100%&lt;br&gt;B3: 40/40 chuyển bác sĩ (13 người xác nhận)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="1500" width="340" height="100" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n33" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="Grounding và định tuyến qua nhiều lượt&lt;br&gt;trên test_B_B1..B4 (eval_grounding.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="1630" width="340" height="60" as="geometry"/></mxCell><mxCell id="e40" value="tập test" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n31" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="LLM #2 của hệ thống" style="ellipse;whiteSpace=wrap;html=1;f
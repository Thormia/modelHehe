POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mental_nutrition_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

REDIS_HOST=localhost
REDIS_PORT=6379

EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ---- Backend chatbot (backend/config.py) ----
# LLM #2: model fine-tune (Ollama: ollama create qwen-huhu -f serving/Modelfile)
GEN_BASE_URL=http://localhost:11434/v1
GEN_MODEL=qwen-huhu
GEN_TEMPERATURE=0.3
# LLM #1 (trích states): model gốc, không fine-tune
EXT_MODEL=qwen2.5:7b-instruct
# Guardrail tầng 2 (giám khảo) và giám khảo chấm điểm eval: khác gốc với LLM #2 (Qwen) để chấm chéo;
# bench 32 ca (scripts/judge_bench.py): gemma3:4b 30/32, aya-expanse:8b 27/32, qwen2.5:7b 26/32
JUDGE_MODEL=gemma3:4b
GUARDRAIL_L2_ENABLED=true
MAX_RETRIES=2
# postgres = SQL + pgvector (cần Docker); offline = đọc file JSON, không cần Docker, không có CBT_CONTEXT
RETRIEVER=postgres
NUTRITION_TOP_K=1
CBT_ENABLED=true
HISTORY_TURNS=6
# Câu đường dây nóng (đã kiểm chứng) chèn vào phản hồi khủng hoảng
CRISIS_HOTLINE_TEXT=Bạn cũng có thể gọi Đường dây nóng Ngày Mai 096 306 1414 (tư vấn tâm lý miễn phí, chỉ trực một số khung giờ); nếu bạn dưới 16 tuổi, hãy gọi Tổng đài quốc gia bảo vệ trẻ em 111 (miễn phí, 24/7).

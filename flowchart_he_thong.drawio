<mxfile host="app.diagrams.net"><diagram name="Luồng hệ thống"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Luồng xử lý một lượt chat của hệ thống (bản final)" style="text;html=1;whiteSpace=wrap;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="-70" width="760" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Người dùng nhắn tin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="0" width="200" height="50" as="geometry"/></mxCell><mxCell id="n4" value="FastAPI POST /chat&lt;br&gt;Nạp phiên từ Redis (TTL 24 giờ):&lt;br&gt;lịch sử, states, cờ y tế, món đã gợi ý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="260" height="70" as="geometry"/></mxCell><mxCell id="n5" value="LLM #1 – Extractor&lt;br&gt;qwen2.5:7b-instruct, temperature 0, JSON&lt;br&gt;4 states · cờ y tế (health_alert) · crisis_flag · panic_flag&lt;br&gt;(đọc tối đa 10 lượt user; chống prompt injection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="320" height="90" as="geometry"/></mxCell><mxCell id="n6" value="Bộ keyword (chạy song song)&lt;br&gt;Từ khoá thuốc → bật cờ y tế&lt;br&gt;Từ khoá khủng hoảng → chỉ dự phòng khi LLM #1 lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="300" height="90" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeome
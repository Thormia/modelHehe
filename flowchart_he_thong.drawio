g hoảng loạn&lt;br&gt;lúc chat)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="e16" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n10" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="Phản hồi hoảng loạn soạn sẵn&lt;br&gt;thở 4-2-6, gọi tên 5 thứ đang thấy&lt;br&gt;gọi 115 (113 nếu bị tấn công) khi đau ngực,&lt;br&gt;khó thở kéo dài, sắp ngất; kèm hotline&lt;br&gt;KHÔNG gọi LLM #2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="475" width="300" height="110" as="geometry"/></mxCell><mxCell id="e18" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="Gộp states vào phiên&lt;br&gt;(giá trị mới ghi đè, null giữ giá trị cũ)&lt;br&gt;Cờ y tế giữ suốt phiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="620" width="260" height="70" as="geometry"/></mxCell><mxCell id="e20" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="Cờ y tế?&lt;br&gt;(dùng thuốc hoặc&lt;br&gt;cơ thể khác thường)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="720" width="200" height="100" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="Nhánh medication&lt;br&gt;ROUTE_NUTRITION: false&lt;br&gt;+ SYSTEM_OVERRIDE (không gợi ý món,&lt;br&gt;khuyên hỏi bác sĩ đang điều trị)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="e24" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="Còn thiếu state?&lt;br&gt;(sleep, appetite,&lt;br&gt;stress, mood)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="850" width="200" height="100" as="geometry"/></mxCell><mxCell id="e26" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n21" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="Nhánh ask_states&lt;br&gt;ROUTE_NUTRITION: false&lt;br&gt;+ MISSING_STATES (hỏi 1–2 state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="260" height="90" as="geometry"/></mxCell><mxCell id="e28" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="States có thay đổi&lt;br&gt;so với lần gợi ý trước?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="990" width="220" height="100" as="geometry"/></mxCell><mxCell id="e30" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n25" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="Nhánh side_talk&lt;br&gt;ROUTE_NUTRITION: false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="260" height="70" as="geometry"/></mxCell><mxCell id="e32" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="Truy xuất (StateRetriever)&lt;br&gt;1. state_effect_map: cộng trọng số theo đích tác động&lt;br&gt;   (không state nào khớp thì dùng ánh xạ chung *:*)&lt;br&gt;2. nutrition_support: 1 món ngẫu nhiên thuộc đích có&lt;br&gt;   trọng số cao nhất, chưa gợi ý trong phiên, không bị loại&lt;br&gt;   (excluded); gợi ý hết thì cho lặp lại&lt;br&gt;3. CBT: bge-m3 + pgvector, so 2 lượt user gần nhất&lt;br&gt;   và tin nhắn hiện tại với cbt_catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="1110" width="340" height="180" as="geometry"/></mxCell><mxCell id="e34" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n29" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="Có món phù hợp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="1300" width="200" height="80" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n33" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n35" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="Nhánh nutrition&lt;br&gt;ROUTE_NUTRITION: true&lt;br&gt;+ NUTRITION_CONTEXT (NUT_xxx) + CBT_CONTEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="1410" width="260" height="80" as="geometry"/></mxCell><mxCell id="e39" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n35" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="Dựng system prompt&lt;br&gt;FIXED_PROMPT (giống từng ký tự dữ liệu train) + khối động&lt;br&gt;+ 6 cặp lượt gần nhất (lượt assistant cũ = side_talk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="1530" width="300" height="80" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n38" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n23" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n27" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n31" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n45" value="LLM #2 – qwen-huhu&lt;br&gt;Qwen2.5-7B-Instruct + LoRA, GGUF Q4_K_M&lt;br&gt;Ollama, temperature 0,3 → JSON&lt;br&gt;(thought_process, side_talk, nutritional_advice, source_reference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="1650" width="300" height="90" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n40" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="Guardrail tầng 1 đạt?&lt;br&gt;JSON đủ khoá · side_talk không rỗng&lt;br&gt;trigger = ROUTE · không lẫn chữ Hán&lt;br&gt;ROUTE true: có advice + mã NUT_ thuộc context,&lt;br&gt;không mg/g/kcal · ROUTE false: không khuyên ăn" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="1765" width="380" height="180" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n45" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="Còn lượt sinh lại?&lt;br&gt;(tối đa 2 lần, dùng chung&lt;br&gt;cho mọi lý do sinh lại)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810" y="1800" width="200" height="100" as="geometry"/></mxCell><mxCell id="e50" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="n49" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="Sửa tối thiểu (repair) nếu có bản dùng được;&lt;br&gt;nếu không: câu trả lời dự phòng&lt;br&gt;(FALLBACK_REPLY, khuyên gặp chuyên gia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="1950" width="300" height="80" as="geometry"/></mxCell><mxCell id="e53" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n49" target="n52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="Guardrail tầng 2 – giám khảo gemma3:4b&lt;br&gt;(khác gốc Qwen; chống prompt injection) đạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="1960" width="280" height="120" as="geometry"/></mxCell><mxCell id="e55" value="Đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n47" target="n54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="Người dùng có rối loạn ăn uống /&lt;br&gt;mang thai / triệu chứng cấp tính&lt;br&gt;(hoặc giám khảo lỗi)&lt;br&gt;→ bỏ gợi ý: lần sinh lại dùng ROUTE false&lt;br&gt;(nhánh nutrition_blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="1960" width="280" height="100" as="geometry"/></mxCell><mxCell id="e57" value="chặn gợi ý món" style="edgeS